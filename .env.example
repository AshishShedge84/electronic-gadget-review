# ==============================================================
# Reviewly AI — Electronic Gadget Review Summarizer & Intelligence
# Full-Stack Deployment Environment Variables (.env.example)
# ==============================================================

# --------------------------------------------------------------
# 1. Frontend Firebase Web Client Configuration (Vite)
# (Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
# --------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id

# --------------------------------------------------------------
# 2. Serverless Backend & AI Model Configuration (Vercel Server-Side Only)
# (Do NOT prefix with VITE_ to keep confidential from client browsers)
# --------------------------------------------------------------
# Google Gemini API Key for generative review summarization & consensus scoring
# (Obtain from Google AI Studio at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------------
# 3. Optional Local Backend & PostgreSQL Database (For Python/Flask fallback)
# --------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/reviewly_db
SECRET_KEY=your_flask_session_secret_key
JWT_SECRET_KEY=your_jwt_signing_secret_key
FLASK_ENV=production
PORT=5000
